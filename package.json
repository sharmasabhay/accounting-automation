{
  "name": "omakase-accounting",
  "version": "0.1.0",
  "description": "Phase 1 accounting automation — procure-to-pay loop",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
