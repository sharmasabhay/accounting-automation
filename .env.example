# Application
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
API_TOKEN=change-me-to-a-secure-random-token
# DRY_RUN=true simulates DBS only. Xero is live when the org is connected (use a demo/test org).
DRY_RUN=true
LOG_LEVEL=info
TIMEZONE=Asia/Singapore

# Database
DATABASE_URL=postgresql://omakase:omakase_secret@localhost:5432/omakase_accounting?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Xero OAuth 2.0
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://127.0.0.1:3000/auth/xero/callback
XERO_TENANT_ID=

# WhatsApp Business API (Meta Cloud)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Meta partner app (Tech Provider) — WhatsApp Embedded Signup for tenant onboarding
# From Meta Developer Console -> your app -> App settings -> Basic
META_APP_ID=
META_APP_SECRET=
# Embedded Signup configuration ID (Facebook Login for Business -> Configurations)
META_CONFIG_ID=
META_GRAPH_VERSION=v21.0
# Public HTTPS URL of this server (used to build tenant onboarding links)
PUBLIC_BASE_URL=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OCR: tesseract = local open-source (Poppler pdftotext + Tesseract). claude = Anthropic vision fallback.
OCR_PROVIDER=tesseract
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (IMAP inbound + SMTP for backend error alerts)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
# Gmail: 16-char App Password, not the normal login password
EMAIL_IMAP_PASSWORD=
EMAIL_INBOX_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed

# Backend error alerts (defaults to sharmasabhay@gmail.com)
ERROR_ALERT_EMAIL=sharmasabhay@gmail.com
ERROR_ALERT_FROM=
ERROR_ALERT_SMTP_HOST=smtp.gmail.com
ERROR_ALERT_SMTP_PORT=587
ERROR_ALERT_SMTP_USER=
ERROR_ALERT_SMTP_PASSWORD=

# DBS Playwright
DBS_IDEAL_URL=https://ideal.dbs.com
DBS_ORG_ID=
DBS_USER_ID=
DBS_HEADLESS=false

# Supervisor contact (WhatsApp)
SUPERVISOR_PHONE=

# Storage paths (relative to project root)
STORAGE_PATH=./storage
AUDIT_LOG_PATH=./storage/audit-logs


