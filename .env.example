# Application
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
API_TOKEN=change-me-to-a-secure-random-token
DRY_RUN=true
LOG_LEVEL=info
TIMEZONE=Asia/Singapore

# Database
DATABASE_URL=postgresql://omakase:omakase_secret@localhost:5432/omakase_accounting?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Xero OAuth 2.0
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://127.0.0.1:3000/auth/xero/callback
XERO_TENANT_ID=

# WhatsApp Business API (Meta Cloud)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OCR (choose one provider)
OCR_PROVIDER=mock
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (IMAP)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_INBOX_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed

# DBS Playwright
DBS_IDEAL_URL=https://ideal.dbs.com
DBS_ORG_ID=
DBS_USER_ID=
DBS_HEADLESS=false

# Supervisor contact (WhatsApp)
SUPERVISOR_PHONE=

# Storage paths (relative to project root)
STORAGE_PATH=./storage
AUDIT_LOG_PATH=./storage/audit-logs


